# Generated by ACS2 SKILL - Ant International Security
# Required external checkouts and checkpoints
SLIME_DIR=/path/to/slime
MEGATRON_DIR=/path/to/Megatron-LM
SLIME_MODEL_CONFIG=/path/to/slime/scripts/models/model.sh
HF_CHECKPOINT=/path/to/hf-checkpoint
BASE_CHECKPOINT=/path/to/distributed-checkpoint
PROMPT_DATA=/path/to/train.jsonl
EVAL_CONFIG=/path/to/eval.yaml

# One-sample interaction pipeline (main.py)
ACTOR_MODEL_BASE_URL=http://127.0.0.1:30000/v1
ACTOR_MODEL_NAME_OR_PATH=/path/to/actor-model
# Add explicitly configured remote service hosts as a comma-separated allowlist.
MODEL_SERVICE_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# Audio model
AUDIO_MODEL_BASE_URL=http://127.0.0.1:8901/v1
AUDIO_MODEL_NAME_OR_PATH=/path/to/audio-model

# Independent feature switches
ENABLE_TRANSITION_CREDIT=1
ENABLE_TEACHER_TRAJECTORIES=1

# Transition-as-Credit extractor
TRANSITION_CREDIT_EXTRACTOR_BASE_URL=http://127.0.0.1:8006/v1
TRANSITION_CREDIT_EXTRACTOR_MODEL=/path/to/extractor-model
TRANSITION_CREDIT_BETA_MIN=0.5
TRANSITION_CREDIT_TAU=0.5
TRANSITION_CREDIT_TEMPERATURE=0.1

# Verified teacher supervision
TEACHER_TRAJECTORY_BANK_PATH=/path/to/teacher-bank.jsonl
TEACHER_TRAJECTORY_TOKENIZER_PATH=/path/to/actor-tokenizer
TEACHER_SUPERVISION_LAMBDA=0.1
